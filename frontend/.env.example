# ChessWeb Frontend Environment Variables
# Copy this file to .env.local for development

# API Configuration
# Local same-machine development
VITE_API_URL=http://localhost:8080/api/v1
VITE_SOCKET_URL=http://localhost:8080
#
# If another device opens the frontend via LAN IP, these values must point to the same backend host,
# for example:
# VITE_API_URL=http://192.168.1.10:8080/api/v1
# VITE_SOCKET_URL=http://192.168.1.10:8080

# Development Mode
# Set to 'true' to use mock API (no backend needed)
# Set to 'false' to use real backend API
VITE_USE_MOCK=false

# App Configuration
VITE_APP_NAME=ChessWeb
VITE_APP_VERSION=1.0.0

# Google OAuth
VITE_GOOGLE_CLIENT_ID=81316592871-a9408j3kfpnearnnirb5uaj7dbceh38a.apps.googleusercontent.com
#
# Google Cloud Console must include every frontend origin you really use, for example:
# - http://localhost:5173
# - http://127.0.0.1:5173
# - http://192.168.1.10:5173

# Optional: Analytics, etc.
# VITE_ANALYTICS_ID=your-analytics-id
