@startuml UML_P3_Ranked_Queue_Activity

title Activity Diagram - Ranked Queue Flow

|User|
start
:Nhấn "Tham gia Ranked";
:Hiển thị màn hình chờ;

|System|
:Thêm User vào Queue;
:Lưu thời gian vào queue;

|MatchmakingEngine|
:Tìm kiếm đối thủ phù hợp;
note right
  Tìm kiếm dựa trên:
  - Rating tương đương (±100 Elo)
  - Thời gian chờ
  - Độ ưu tiên
end note

if (Tìm thấy đối thủ?) then (yes)
    :Tạo Ranked Match;
    :Gán 2 người chơi vào match;
    
    |System|
    :Khởi tạo Game;
    :Thiết lập Clock (10 phút/người);
    :Thiết lập InactivityTimer (2 phút);
    
    |User|
    :Nhận thông báo "Match Found";
    :Chuyển đến Game Board;
    
    |System|
    :Bắt đầu game;
    
    repeat
        |User|
        :Đi nước cờ;
        
        |System|
        :Reset InactivityTimer;
        :Cập nhật Board Position;
        :Gửi move cho đối thủ;
        :Kiểm tra game kết thúc;
        
    repeat while (Game chưa kết thúc?) is (yes)
    -> no;
    
    |System|
    :Xác định kết quả\n(Win/Lose/Draw);
    
    |EloService|
    :Tính toán thay đổi Elo;
    note right
      Công thức Elo:
      - Expected score
      - Actual score
      - K-factor
      - New rating
    end note
    
    :Cập nhật Rating vào DB;
    
    |System|
    :Lưu Game History;
    :Cập nhật User Stats;
    
    |User|
    :Hiển thị kết quả;
    :Hiển thị thay đổi Elo;
    
else (no - timeout)
    |System|
    :Gửi thông báo "Không tìm thấy";
    
    |User|
    :Có thể thử lại;
    
endif

stop

@enduml
