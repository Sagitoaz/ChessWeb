@startuml UML_P3_Ranked_Match_StateMachine

title State Machine Diagram - Ranked Match Lifecycle

[*] --> Queuing : User joins ranked queue

state Queuing {
    [*] --> WaitingForMatch
    WaitingForMatch : User in matchmaking queue
    WaitingForMatch : Searching for opponent
    
    WaitingForMatch --> MatchmakingInProgress : Potential match found
    MatchmakingInProgress --> WaitingForMatch : Match validation failed
}

Queuing --> Matched : Opponent found

state Matched {
    [*] --> AwaitingConfirmation
    AwaitingConfirmation : Both players notified
    AwaitingConfirmation : Waiting for acceptance
    
    AwaitingConfirmation --> GameReady : Both accepted
}

Matched --> InGame : Game initialized

state InGame {
    [*] --> Playing
    
    state Playing {
        [*] --> WhiteTurn
        WhiteTurn --> BlackTurn : White makes move
        BlackTurn --> WhiteTurn : Black makes move
        
        WhiteTurn : Clock running for White
        WhiteTurn : InactivityTimer active
        
        BlackTurn : Clock running for Black
        BlackTurn : InactivityTimer active
    }
    
    Playing --> CheckingGameEnd : After each move
    CheckingGameEnd --> Playing : Game continues
    
    state CheckingGameEnd <<choice>>
    CheckingGameEnd --> GameEnded : Checkmate/Stalemate detected
    
    state fork_afk <<fork>>
    Playing --> fork_afk : Monitoring
    
    fork_afk --> MonitoringAFK
    fork_afk --> MonitoringConnection
    
    state MonitoringAFK {
        [*] --> Active
        Active : InactivityTimer < 2 min
        Active --> AFKDetected : Timer >= 2 min
    }
    
    state MonitoringConnection {
        [*] --> Connected
        Connected : Heartbeat OK
        Connected --> Disconnected : Connection lost
        Disconnected : Waiting for reconnect (30s)
        Disconnected --> Connected : Reconnected
    }
    
    MonitoringAFK --> Forfeited : AFK timeout
    MonitoringConnection --> Forfeited : Disconnect timeout
}

InGame --> Finished : Normal game end
InGame --> Forfeited : AFK or Disconnect

state Forfeited {
    [*] --> DeterminingPenalty
    
    DeterminingPenalty : Calculate forfeit reason
    
    state DeterminingPenalty <<choice>>
    DeterminingPenalty --> AFKForfeit : AFK > 2 min
    DeterminingPenalty --> DisconnectForfeit : Connection lost
    DeterminingPenalty --> NoMovesForfeit : No moves + early quit
    
    AFKForfeit : Winner: Opponent
    AFKForfeit : Loser: AFK player
    AFKForfeit : Elo penalty applied
    
    DisconnectForfeit : Winner: Opponent
    DisconnectForfeit : Loser: Disconnected player
    DisconnectForfeit : Elo penalty applied
    
    NoMovesForfeit : No winner/loser
    NoMovesForfeit : No Elo change
    NoMovesForfeit : Match cancelled
}

state Finished {
    [*] --> CalculatingElo
    
    CalculatingElo : Determine winner/loser/draw
    CalculatingElo : Calculate Elo changes
    CalculatingElo : Update ratings
    
    CalculatingElo --> UpdatingDatabase
    
    UpdatingDatabase : Save match result
    UpdatingDatabase : Update Elo history
    UpdatingDatabase : Update user stats
    
    UpdatingDatabase --> NotifyingPlayers
    
    NotifyingPlayers : Send results to players
    NotifyingPlayers : Display Elo changes
}

Forfeited --> Completed : Penalty applied
Finished --> Completed : Updates saved

Completed --> [*]

' Timeout transitions
Queuing --> Cancelled : Queue timeout (5 min)
Matched --> Cancelled : Accept timeout (30s)
Cancelled --> [*]

note right of Queuing
  User vào hàng đợi ranked.
  Matchmaking engine tìm đối thủ
  có rating tương đương (±100 Elo).
end note

note right of InGame
  Game đang diễn ra.
  Giám sát đồng thời:
  - Hoạt động người chơi (2 phút)
  - Kết nối mạng (30s grace period)
  - Thời gian trên đồng hồ (10 phút/người)
end note

note right of Forfeited
  Xử lý thua do vi phạm:
  - AFK > 2 phút: -Elo
  - Disconnect: -Elo
  - Chưa đi nước + quit sớm: không mất Elo
end note

note bottom of Finished
  Cập nhật Elo theo công thức chuẩn:
  - Expected Score: E = 1/(1+10^((Rb-Ra)/400))
  - New Rating: R' = R + K(S - E)
  - K-factor = 32
end note

@enduml
