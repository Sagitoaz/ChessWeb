PORT=8080
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=chessweb

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Frontend origin for CORS (Railway production)
# Option 1: single origin
FRONTEND_URL=http://localhost:5173
# Option 2: multiple origins separated by comma (overrides FRONTEND_URL if set)
CORS_ORIGINS=

# Stockfish local binary configuration
# Stockfish must be installed: sudo dnf install stockfish (on Fedora) or apt install stockfish (on Ubuntu)
STOCKFISH_BINARY_PATH=/usr/bin/stockfish
STOCKFISH_LOG_ENABLED=false
STOCKFISH_LOG_FILE=./stockfish_engine.log
STOCKFISH_TIMEOUT_MS=5000

# Groq AI (move commentary) - Get key from https://console.groq.com
GROQ_API_KEY= 
GROQ_MODEL=mixtral-8x7b-32768

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
